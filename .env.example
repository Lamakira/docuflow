####
# DocuFlow environment configuration.
#
# Copy to `.env` and fill in. `npm run dev` and `npm start` load `.env` if it is
# present; deployments set the same variables through their own mechanism.
#
# This file is the register of record for every variable the repository reads —
# the server's, the release scripts', and the test harness's. The server's are
# read in `server/config.ts` and nowhere else, which refuses to boot when a
# required one is missing. docs/CONFIGURATION.md explains each in prose.
#
# ADR-0018: this repository is a parallel environment. Never put a production
# credential, production URL, or production dataset in it — not even briefly.
# Every account named here is a fresh one provisioned for this effort.
####

# ─── Database (required) ─────────────────────────────────────────────────────
# Either DATABASE_URL, or every PG* variable instead. DATABASE_URL wins.
DATABASE_URL=postgresql://user:password@host:5432/docuflow
# PGHOST=localhost
# PGPORT=5432
# PGUSER=docuflow
# PGPASSWORD=change-me
# PGDATABASE=docuflow_dev

# node-postgres instead of the Neon serverless driver — needed for a database
# Neon's WebSocket driver cannot reach, such as a local or CI Postgres.
# DB_DRIVER=pg

# ─── Sessions (required) ─────────────────────────────────────────────────────
# Signs session cookies. Any long random string; rotating it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Desktop access-token signing key (required) ─────────────────────────────
# Signs the hour-long tokens the desktop agent presents, written as
# <key-id>:<secret>. The id names the key and travels in every token it signs;
# the secret is 32+ random bytes, e.g. openssl rand -hex 32. There is no
# generated fallback: a key invented at boot would be gone at the next one, and
# every signed-in agent with it, so boot stops instead of signing the fleet out.
JWT_SECRET=2026-08:change-me-to-a-long-random-string
# Set only during a rotation: while it is here, tokens signed with either key
# verify and new ones carry the current key's id. Clear it once the longest
# token lifetime (1 hour) has passed. docs/CONFIGURATION.md has the procedure.
# JWT_PREVIOUS_SECRET=2026-05:the-key-being-retired

# ─── Object storage (required) ───────────────────────────────────────────────
# Bucket roots, written as /<bucket>/<prefix>. The private root holds uploads and
# evidence; the first public search path receives public uploads.
PRIVATE_OBJECT_DIR=/my-bucket/.private
PUBLIC_OBJECT_SEARCH_PATHS=/my-bucket/public

# One of the next two is required: signed URLs need a key that can sign, so the
# identity must be a service account, and boot refuses an environment naming
# neither. The boot line reports which of the two is in use.
#
# The key file's JSON — verbatim on one line, or base64-encoded, which survives
# secret stores that mangle the newlines inside private_key.
GCS_SERVICE_ACCOUNT_KEY=
# Or a path to that same key file, read by the Google SDK rather than by this app.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Only needed when the key file omits it.
# GCS_PROJECT_ID=

# ─── HTTP server ─────────────────────────────────────────────────────────────
# development | production | test. Defaults to development; the production build
# replaces it with a literal, so it is set by the runtime, rarely by hand.
# NODE_ENV=development
# PORT=5000
# Absolute base URL this deployment is reached at, used for links in outbound
# email. Defaults to http://localhost:5000.
# APP_URL=https://docuflow.example.com

# ─── Email (optional — sends fail and report why while unset) ────────────────
RESEND_API_KEY=
# Verified sender. Defaults to DocuFlow <noreply@resend.dev>.
# RESEND_FROM_EMAIL=DocuFlow <noreply@example.com>

# ─── AI and transcription (optional — each feature fails while unset) ────────
# Embeddings, retrieval-augmented chat, and audio transcription.
OPENAI_API_KEY=
# Fathom transcripts; without it the scraper falls back to the browser path.
# FATHOM_API_KEY=

# ─── Desktop releases (optional) ─────────────────────────────────────────────
# Bearer token the release pipeline presents to POST /api/internal/desktop-releases.
# DESKTOP_RELEASE_CI_TOKEN=
# Bucket the desktop installers are published to, for scripts/release-desktop.mjs
# and scripts/upload-to-gcs.mjs.
# INSTALLER_GCS_BUCKET=
# The deployment scripts/release-desktop.mjs registers the release against. It
# has no default: naming the target every time is what keeps a release run from
# reaching a deployment nobody meant to publish to (ADR-0018).
# DOCUFLOW_API_URL=https://docuflow.example.com
# The GitHub repository and workflow scripts/release-desktop.mjs builds the
# installers on. Both default to this project's own; override to build elsewhere.
# GH_REPO=owner/repository
# GH_WORKFLOW=desktop-release.yml

# ─── MCP (optional) ──────────────────────────────────────────────────────────
# Admin-impersonation key accepted as X-API-Key. Phase 5 removes it.
# MCP_API_KEY=

# ─── Tests (optional — read by the harness, not by the server) ───────────────
# The database `npm test` runs against. It is truncated between tests, so it must
# be disposable. Defaults to the docker-compose.test.yml Postgres on 5433.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/docuflow_test
# The harness refuses a non-local TEST_DATABASE_URL unless this is 1 (ADR-0018).
# Set it only for a remote test database holding nothing you want to keep.
# ALLOW_REMOTE_TEST_DB=1

# ─── Replit OIDC login (optional — removed in Phase 5) ───────────────────────
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
# Set by the Replit runtime, not by hand. They stand in for APP_URL when it is
# unset, so a Replit deployment keeps producing the links it always did; they
# leave with the OIDC login in Phase 5.
# REPLIT_DOMAINS=my-app.replit.app
# REPLIT_DEV_DOMAIN=my-app.replit.dev
