modules = ["web", "postgresql-16", "nodejs-24"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[deployment]
# Autoscale carries the HTTP runtime only. ADR-0013's lease-elected scheduler
# needs a process that never sleeps, and one App holds one deployment type — so
# the worker is a second Replit project on this same repository, Reserved VM,
# selecting its role from DOCUFLOW_ROLE rather than from a divergent copy of
# this file. See docs/migration/phase-2-deployments-and-databases.md (#53).
deploymentTarget = "autoscale"
# Migrations run here and nowhere else. A failing Build command fails the build
# and blocks the publish, which is the gated pre-deploy step ADR-0017 requires
# and ADR-0021 places in the build. Not at boot — #24 deleted boot-time DDL. Not
# in `run` — Autoscale runs that in every instance and scripts/migrate.ts takes
# no advisory lock, so two instances starting together would race the journal.
# After `npm run build`, because dist/migrate.mjs is one of its outputs (#35).
build = ["sh", "-c", "npm run build && node dist/migrate.mjs"]
run = ["npm", "run", "start"]

[env]
PORT = "5000"
# node-postgres rather than the Neon serverless driver, in both environments.
# The serverless driver reaches Neon over WebSockets, and Replit's databases are
# its own Postgres (Helium) since 2025-12-04; node-postgres reaches that and a
# Neon database alike over plain TLS, which is why every script in scripts/
# already uses it. It is also the instrumented path — the Neon driver emits no
# query spans (docs/OBSERVABILITY.md).
DB_DRIVER = "pg"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
# Object storage, Resend, the database, and OpenAI are no longer Replit
# integrations: every one now reads direct credentials from the environment
# (see .env.example, docs/CONFIGURATION.md). Only the OIDC login remains, and
# it leaves in Phase 5.
integrations = ["javascript_log_in_with_replit:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[userenv]

[userenv.shared]
DB_DRIVER = "pg"
PRIVATE_OBJECT_DIR = "/replit-objstore-b63748fd-2e8b-4090-8d94-254080b61ad7/.private"
PUBLIC_OBJECT_SEARCH_PATHS = "/replit-objstore-b63748fd-2e8b-4090-8d94-254080b61ad7/public"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[objectStorage]
defaultBucketID = "replit-objstore-b63748fd-2e8b-4090-8d94-254080b61ad7"
# MCP_API_KEY must be set via Replit Secrets (not hardcoded here).
# Go to Tools > Secrets in Replit and add MCP_API_KEY there.
