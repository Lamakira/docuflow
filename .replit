modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
# Object storage, Resend, the database, and OpenAI are no longer Replit
# integrations: every one now reads direct credentials from the environment
# (see .env.example, docs/CONFIGURATION.md). Only the OIDC login remains, and
# it leaves in Phase 5.
integrations = ["javascript_log_in_with_replit:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[userenv]
# MCP_API_KEY must be set via Replit Secrets (not hardcoded here).
# Go to Tools > Secrets in Replit and add MCP_API_KEY there.
