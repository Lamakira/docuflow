{
  "name": "docuflow-desktop-agent",
  "version": "0.1.5",
  "description": "DocuFlow Desktop Agent — time tracking, activity monitoring, and screenshot capture",
  "main": ".webpack/main",
  "private": true,
  "homepage": "https://techma-doc--masdouk1.replit.app",
  "scripts": {
    "predev": "node scripts/kill-port.js 9000",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "dist:win": "node scripts/dist-win.js",
    "dist:win:debug": "node scripts/dist-win.js --debug",
    "dist:linux": "node scripts/dist-linux.js",
    "dist:ubuntu": "node scripts/dist-linux.js",
    "dist:mac": "node scripts/dist-mac.js",
    "dist": "node scripts/dist-win.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.docuflow.agent",
    "productName": "DocuFlow Desktop Agent",
    "copyright": "Copyright © 2024 DocuFlow",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "afterSign": "scripts/notarize.js",
    "win": {
      "target": "nsis",
      "executableName": "docuflow-agent",
      "icon": "assets/icon.ico",
      "artifactName": "DocuFlow-Agent-${version}-windows-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocuFlow Desktop Agent",
      "uninstallDisplayName": "DocuFlow Desktop Agent",
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "DocuFlow-Agent-${version}-macos.dmg"
    },
    "linux": {
      "target": "deb",
      "executableName": "docuflow-agent",
      "icon": "assets/icon.png"
    },
    "deb": {
      "packageName": "docuflow-agent",
      "artifactName": "DocuFlow-Agent-${version}-linux-amd64.deb",
      "depends": [
        "libayatana-appindicator3-1"
      ],
      "maintainer": "DocuFlow <support@docuflow.app>"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@electron/notarize": "^2.5.0",
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-deb": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "mini-css-extract-plugin": "^2.10.1",
    "png-to-ico": "^3.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uiohook-napi": "^1.5.3"
  }
}
